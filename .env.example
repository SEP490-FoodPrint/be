PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:3001

# Redis Docker local. Keep REDIS_PORT and REDIS_URL in sync if changing the port.
REDIS_PORT=6379
REDIS_URL=redis://127.0.0.1:6379/0
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300

# Replace with your own local PostgreSQL URL; URL-encode special characters in credentials.
DATABASE_URL="postgresql://your_local_db_user:your_local_db_password@127.0.0.1:5432/foodprint?schema=foodprint"

# Use a different long random secret on each developer machine.
JWT_SECRET=replace_with_your_own_long_random_secret
JWT_EXPIRES_IN=7d
