PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:3001
# Fixed HTTP/HTTPS origin for persisted QR trace URLs; keep printed hostname stable and do not derive from Host header
PUBLIC_TRACE_ORIGIN=http://localhost:5000

# Prisma Connection URL to Azure PostgreSQL
DATABASE_URL= your_own_postgresql_connection_string_here
# Redis Docker local
REDIS_PORT=6379
REDIS_URL=redis://127.0.0.1:6379/0
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300

# Auth JWT
JWT_SECRET=replace-with-a-unique-random-secret
AUTH_ACCESS_TTL_SECONDS=900
AUTH_REFRESH_TTL_SECONDS=604800

# Khóa Feistel cho mã nghiệp vụ FP-XX-NNNNN: đúng 64 ký tự hex (32 byte), mỗi môi trường một khóa riêng.
# KHÔNG đổi khóa sau khi đã phát hành mã. Tạo: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BUSINESS_CODE_KEY=replace-with-64-hex-characters

# Optional: required for onboarding documents and ingredient image uploads
CLOUDINARY_CLOUD_NAME=replace-with-your-cloud-name
CLOUDINARY_API_KEY=replace-with-your-api-key
CLOUDINARY_API_SECRET=replace-with-your-api-secret

# Resend: use a sender on a domain verified in your Resend account
RESEND_API_KEY=re_replace-with-your-api-key
RESEND_FROM=FoodPrint <no-reply@your-verified-domain.example>
# Ảnh logo công khai (https) thay cho logo dự án nhúng sẵn trong email; để trống sẽ dùng logo nhúng inline
EMAIL_LOGO_URL=

# Blockchain anchoring (tắt mặc định). BLOCKCHAIN_NETWORK: localhost | sepolia
BLOCKCHAIN_ENABLED=false
BLOCKCHAIN_NETWORK=localhost
BLOCKCHAIN_RPC_URL=http://127.0.0.1:8545
BLOCKCHAIN_DEPLOYMENT_PATH=./blockchain/FoodPrintHashRegistry.json
# Ví Writer để API ký giao dịch; bỏ trống chỉ dùng được với Hardhat node local
BLOCKCHAIN_WRITER_PRIVATE_KEY=
# Thời gian chờ receipt (ms), mặc định 120000; quá hạn thì version FAILED nhưng vẫn giữ tx hash
BLOCKCHAIN_RECEIPT_TIMEOUT_MS=120000
