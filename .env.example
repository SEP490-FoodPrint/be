PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:3001

# PostgreSQL local. Create the foodprint_db database first, then replace the
# username/password below with the credentials installed on your machine.
# URL-encode special characters in the username/password (for example: @ -> %40).
DATABASE_URL="postgresql://postgres:your_local_postgres_password@127.0.0.1:5432/foodprint_db?schema=foodprint"
# Redis Docker local
REDIS_PORT=6379
REDIS_URL=redis://127.0.0.1:6379/0
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300

# Auth JWT
JWT_SECRET=replace-with-a-unique-random-secret
AUTH_ACCESS_TTL_SECONDS=900
AUTH_REFRESH_TTL_SECONDS=604800

# Optional: required when submitting files with onboarding profiles
CLOUDINARY_CLOUD_NAME=replace-with-your-cloud-name
CLOUDINARY_API_KEY=replace-with-your-api-key
CLOUDINARY_API_SECRET=replace-with-your-api-secret

# Resend: use a sender on a domain verified in your Resend account
RESEND_API_KEY=re_replace-with-your-api-key
RESEND_FROM=FoodPrint <no-reply@your-verified-domain.example>

# Azure seed also requires AZURE_DATABASE_HOST and the explicit --azure flag.
SEED_TEST_PASSWORD=
