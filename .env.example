PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:3001

# PostgreSQL local. Create the foodprint_db database first, then replace the
# username/password below with the credentials installed on your machine.
# URL-encode special characters in the username/password (for example: @ -> %40).
DATABASE_URL="postgresql://postgres:your_local_postgres_password@127.0.0.1:5432/foodprint_db?schema=foodprint"
# Redis Docker local
REDIS_PORT=6379
REDIS_URL=redis://127.0.0.1:6379/0
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300

# Use a different long random secret on each developer machine.
JWT_SECRET=replace_with_your_own_long_random_secret
JWT_EXPIRES_IN=7d
