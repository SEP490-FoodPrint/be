PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:3001

# Prisma Connection URL to Azure PostgreSQL
DATABASE_URL= your_own_postgresql_connection_string_here
# Redis Docker local
REDIS_PORT=6379
REDIS_URL=redis://127.0.0.1:6379/0
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300

# Auth JWT
JWT_SECRET=replace-with-a-unique-random-secret
AUTH_ACCESS_TTL_SECONDS=900
AUTH_REFRESH_TTL_SECONDS=604800

# Optional: required when submitting files with onboarding profiles
CLOUDINARY_CLOUD_NAME=replace-with-your-cloud-name
CLOUDINARY_API_KEY=replace-with-your-api-key
CLOUDINARY_API_SECRET=replace-with-your-api-secret

# Resend: use a sender on a domain verified in your Resend account
RESEND_API_KEY=re_replace-with-your-api-key
RESEND_FROM=FoodPrint <no-reply@your-verified-domain.example>
