// Source: prisma/migrations/0_init/migration.sql and subsequent versioned migrations.
// SQL-first schema for the new database; no introspection of the old local database.
// Database-only rules and deployment status: database/SCHEMA_BASELINE.md.

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "cjs"
  importFileExtension = ""
  previewFeatures     = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
  schemas  = ["foodprint"]
}

/// Physical table for conceptual M:N relationship Class HAS ALLERGY IngredientEntry. No Student entity; affected_count is a class-level aggregate.
/// CHECK constraints are defined in the source SQL and are not represented in Prisma.
model ClassAllergy {
  classId              String                @map("class_id") @db.Uuid
  ingredientEntryId    String                @map("ingredient_entry_id") @db.Uuid
  affectedCount        Int                   @map("affected_count") @db.Integer
  updatedByUserId      String?               @map("updated_by_user_id") @db.Uuid
  updatedAt            DateTime              @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  Class                Class                 @relation("class_allergies_class_id__classes", fields: [classId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  IngredientEntry      IngredientEntry       @relation("class_allergies_ingredient_entry_id__ingredient_entries", fields: [ingredientEntryId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  User                 User?                 @relation("class_allergies_updated_by_user_id__users", fields: [updatedByUserId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  dailyAllergyPortions DailyAllergyPortion[] @relation("daily_allergy_portions_class_id_ingredient_entry_id__class_allergies")

  @@id([classId, ingredientEntryId])
  @@map("class_allergies")
  @@schema("foodprint")
}

/// CHECK constraints are defined in the source SQL and are not represented in Prisma.
model Class {
  id                     String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schoolId               String             @map("school_id") @db.Uuid
  name                   String             @db.VarChar(120)
  academicYear           String?            @map("academic_year") @db.VarChar(30)
  registeredMealPortions Int                @default(0) @map("registered_meal_portions") @db.Integer
  status                 EntityStatus       @default(ACTIVE)
  createdAt              DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime           @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  School                 School             @relation("classes_school_id__schools", fields: [schoolId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  dailyMealPortions      DailyMealPortion[] @relation("daily_meal_portions_class_id__classes")
  classAllergies         ClassAllergy[]     @relation("class_allergies_class_id__classes")

  @@unique([schoolId, name, academicYear])
  @@index([schoolId], map: "idx_classes_school_id")
  @@map("classes")
  @@schema("foodprint")
}

model CommuneFoodSafetyUnit {
  id                          String                       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code                        String                       @db.VarChar(80)
  name                        String                       @db.VarChar(255)
  address                     String?                      @db.Text
  email                       String?                      @db.Citext
  phone                       String?                      @db.VarChar(30)
  status                      EntityStatus                 @default(ACTIVE)
  createdAt                   DateTime                     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                   DateTime                     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  users                       User[]                       @relation("users_commune_food_safety_unit_id__commune_food_safety_units")
  foodSafetyReportForwardings FoodSafetyReportForwarding[] @relation("food_safety_report_forwardings_recipient_commune_food_safety_unit_id__commune_food_safety_units")
  userPermissionDenials       UserPermissionDenial[]       @relation("user_permission_denials_commune_food_safety_unit_id__commune_food_safety_units")

  @@unique([code])
  @@map("commune_food_safety_units")
  @@schema("foodprint")
}

/// Physical table for conceptual M:N relationship CookingBatch USES IngredientLot.
/// CHECK constraints are defined in the source SQL and are not represented in Prisma.
model CookingBatchLot {
  cookingBatchId  String        @map("cooking_batch_id") @db.Uuid
  ingredientLotId String        @map("ingredient_lot_id") @db.Uuid
  /// Legacy database-only column, retained during phase 1 for older Backend versions.
  plannedQuantity Decimal?      @map("planned_quantity") @ignore @db.Decimal(14, 3)
  /// Backend-computed allocation. Reserved before completion; inventory usage is posted only on completion.
  quantityUsed    Decimal       @map("quantity_used") @db.Decimal(14, 3)
  unit            String        @db.VarChar(30)
  CookingBatch    CookingBatch  @relation("cooking_batch_lots_cooking_batch_id__cooking_batches", fields: [cookingBatchId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  IngredientLot   IngredientLot @relation("cooking_batch_lots_ingredient_lot_id__ingredient_lots", fields: [ingredientLotId], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@id([cookingBatchId, ingredientLotId])
  @@index([ingredientLotId], map: "idx_cooking_batch_lots_lot")
  @@map("cooking_batch_lots")
  @@schema("foodprint")
}

/// CHECK constraints are defined in the source SQL and are not represented in Prisma.
model CookingBatch {
  id                    String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  batchCode             String                @map("batch_code") @db.VarChar(100)
  menuDayId             String                @map("menu_day_id") @db.Uuid
  dishId                String                @map("dish_id") @db.Uuid
  /// Meal slot inherited from selected MenuDay-Dish entry.
  mealType              MealType              @map("meal_type")
  /// Snapshot of school policy at creation; old batches unaffected by later school configuration changes.
  cookingModeApplied    CookingMode           @map("cooking_mode_applied")
  createdByUserId       String                @map("created_by_user_id") @db.Uuid
  status                CookingBatchStatus    @default(UNCONFIRMED)
  /// Backend-computed portions from finalized demand; completion uses this confirmed plan.
  plannedPortions       Int?                  @map("planned_portions") @db.Integer
  /// Legacy database-only column, retained during phase 1 for older Backend versions.
  preparedPortions      Int?                  @map("prepared_portions") @ignore @db.Integer
  note                  String?               @db.Text
  /// JSON record for Decision 1246/QĐ-BYT 3-step food safety inspection (temperatures, sensory, hygiene checks).
  inspectionData        Json?                 @map("inspection_data") @db.JsonB
  confirmedByUserId     String?               @map("confirmed_by_user_id") @db.Uuid
  /// Time kitchen confirmed the PLAN, BEFORE cooking (not completion time).
  confirmedAt           DateTime?             @map("confirmed_at") @db.Timestamptz(6)
  completedByUserId     String?               @map("completed_by_user_id") @db.Uuid
  /// Time kitchen confirmed completion of the plan; COMPLETED is required for meal allocation.
  completedAt           DateTime?             @map("completed_at") @db.Timestamptz(6)
  createdAt             DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime              @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  MenuDay               MenuDay               @relation("cooking_batches_menu_day_id__menu_days", fields: [menuDayId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  Dish                  Dish                  @relation("cooking_batches_dish_id__dishes", fields: [dishId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  createdByUser         User                  @relation("cooking_batches_created_by_user_id__users", fields: [createdByUserId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  confirmedByUser       User?                 @relation("cooking_batches_confirmed_by_user_id__users", fields: [confirmedByUserId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  completedByUser       User?                 @relation("cooking_batches_completed_by_user_id__users", fields: [completedByUserId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  MenuDayDish           MenuDayDish           @relation("cooking_batches_menu_day_id_dish_id_meal_type__menu_day_dishes", fields: [menuDayId, dishId, mealType], references: [menuDayId, dishId, mealType], onDelete: Restrict, onUpdate: NoAction, map: "fk_cooking_batch_menu_dish_meal")
  cookingBatchLots      CookingBatchLot[]     @relation("cooking_batch_lots_cooking_batch_id__cooking_batches")
  RetainedFoodSample    RetainedFoodSample?   @relation("retained_food_samples_cooking_batch_id__cooking_batches")
  mealAllocationBatches MealAllocationBatch[] @relation("meal_allocation_batches_cooking_batch_id__cooking_batches")
  traceabilityAnchors   TraceabilityAnchor[]  @relation("traceability_anchors_cooking_batch_id__cooking_batches")

  @@unique([batchCode])
  @@index([menuDayId], map: "idx_cooking_batches_menu_day")
  @@index([dishId], map: "idx_cooking_batches_dish")
  @@index([menuDayId, mealType, status], map: "idx_cooking_batches_meal_state")
  @@map("cooking_batches")
  @@schema("foodprint")
}

/// Daily allergy-specific portion count for one DailyMealPortion and one class-level allergy pair (Class, IngredientEntry).
/// CHECK constraints are defined in the source SQL and are not represented in Prisma.
model DailyAllergyPortion {
  dailyMealPortionId String           @map("daily_meal_portion_id") @db.Uuid
  classId            String           @map("class_id") @db.Uuid
  ingredientEntryId  String           @map("ingredient_entry_id") @db.Uuid
  portionCount       Int              @map("portion_count") @db.Integer
  createdAt          DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  DailyMealPortion   DailyMealPortion @relation("daily_allergy_portions_daily_meal_portion_id__daily_meal_portions", fields: [dailyMealPortionId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  ClassAllergy       ClassAllergy     @relation("daily_allergy_portions_class_id_ingredient_entry_id__class_allergies", fields: [classId, ingredientEntryId], references: [classId, ingredientEntryId], onDelete: Restrict, onUpdate: NoAction, map: "fk_daily_allergy_class_entry")

  @@id([dailyMealPortionId, classId, ingredientEntryId])
  @@index([classId, ingredientEntryId], map: "idx_daily_allergy_portions_class_entry")
  @@map("daily_allergy_portions")
  @@schema("foodprint")
}

/// CHECK constraints are defined in the source SQL and are not represented in Prisma.
model DailyMealPortion {
  id                   String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  classId              String                  @map("class_id") @db.Uuid
  confirmedByUserId    String                  @map("confirmed_by_user_id") @db.Uuid
  mealDate             DateTime                @map("meal_date") @db.Date
  /// Demand scoped to LUNCH or AFTERNOON; unique per Class/date/meal.
  mealType             MealType                @map("meal_type")
  totalPortions        Int                     @map("total_portions") @db.Integer
  allergyNotes         String?                 @map("allergy_notes") @db.Text
  status               MealPortionStatus       @default(DRAFT)
  finalizedAt          DateTime?               @map("finalized_at") @db.Timestamptz(6)
  createdAt            DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime                @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  Class                Class                   @relation("daily_meal_portions_class_id__classes", fields: [classId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  User                 User                    @relation("daily_meal_portions_confirmed_by_user_id__users", fields: [confirmedByUserId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  dailyAllergyPortions DailyAllergyPortion[]   @relation("daily_allergy_portions_daily_meal_portion_id__daily_meal_portions")
  MealAllocation       MealAllocation?         @relation("meal_allocations_daily_meal_portion_id__daily_meal_portions")
  portionGroups        DailyMealPortionGroup[]

  @@unique([classId, mealDate, mealType])
  @@index([mealDate], map: "idx_daily_meal_portions_date")
  @@index([classId, mealDate, mealType], map: "idx_dmp_class_date_meal")
  @@map("daily_meal_portions")
  @@schema("foodprint")
}

/// CHECK constraints are defined in the source SQL and are not represented in Prisma.
model Delivery {
  id                        String                      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  deliveryNo                String                      @map("delivery_no") @db.VarChar(80)
  supplyRequestId           String                      @map("supply_request_id") @db.Uuid
  supplierId                String                      @map("supplier_id") @db.Uuid
  status                    DeliveryStatus              @default(CREATED)
  createdByUserId           String?                     @map("created_by_user_id") @db.Uuid
  expectedArrivalAt         DateTime?                   @map("expected_arrival_at") @db.Timestamptz(6)
  arrivedAt                 DateTime?                   @map("arrived_at") @db.Timestamptz(6)
  receivedByUserId          String?                     @map("received_by_user_id") @db.Uuid
  receivedAt                DateTime?                   @map("received_at") @db.Timestamptz(6)
  vehiclePlate              String?                     @map("vehicle_plate") @db.VarChar(40)
  note                      String?                     @db.Text
  createdAt                 DateTime                    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                 DateTime                    @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  SupplyRequest             SupplyRequest               @relation("deliveries_supply_request_id__supply_requests", fields: [supplyRequestId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  Supplier                  Supplier                    @relation("deliveries_supplier_id__suppliers", fields: [supplierId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  createdByUser             User?                       @relation("deliveries_created_by_user_id__users", fields: [createdByUserId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  receivedByUser            User?                       @relation("deliveries_received_by_user_id__users", fields: [receivedByUserId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  deliveryApprovals         DeliveryApproval[]          @relation("delivery_approvals_delivery_id__deliveries")
  deliveryItems             DeliveryItem[]              @relation("delivery_items_delivery_id__deliveries")
  ingredientQualityFeedback IngredientQualityFeedback[] @relation("ingredient_quality_feedback_delivery_id__deliveries")
  traceabilityAnchors       TraceabilityAnchor[]        @relation("traceability_anchors_delivery_id__deliveries")

  @@unique([deliveryNo])
  @@index([createdByUserId], map: "idx_deliveries_created_by")
  @@index([supplyRequestId, status], map: "idx_deliveries_request_status")
  @@map("deliveries")
  @@schema("foodprint")
}

/// Physical table for conceptual User APPROVES INCOMING Delivery relationship. One decision per required role per Delivery.
/// CHECK constraints are defined in the source SQL and are not represented in Prisma.
model DeliveryApproval {
  id         String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  deliveryId String           @map("delivery_id") @db.Uuid
  userId     String           @map("user_id") @db.Uuid
  roleId     String           @map("role_id") @db.Uuid
  decision   ApprovalDecision
  reason     String?          @db.Text
  decidedAt  DateTime         @default(now()) @map("decided_at") @db.Timestamptz(6)
  Delivery   Delivery         @relation("delivery_approvals_delivery_id__deliveries", fields: [deliveryId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  User       User             @relation("delivery_approvals_user_id__users", fields: [userId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  Role       Role             @relation("delivery_approvals_role_id__roles", fields: [roleId], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@unique([deliveryId, userId])
  @@unique([deliveryId, roleId])
  @@index([deliveryId], map: "idx_delivery_approvals_delivery")
  @@map("delivery_approvals")
  @@schema("foodprint")
}

/// Actual ingredient lines in a Delivery. Each row references the corresponding SupplyRequestItem and can contain multiple IngredientLot rows.
/// CHECK constraints are defined in the source SQL and are not represented in Prisma.
model DeliveryItem {
  id                  String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  deliveryId          String            @map("delivery_id") @db.Uuid
  supplyRequestItemId String            @map("supply_request_item_id") @db.Uuid
  actualQuantity      Decimal           @map("actual_quantity") @db.Decimal(14, 3)
  unit                String            @db.VarChar(30)
  note                String?           @db.Text
  Delivery            Delivery          @relation("delivery_items_delivery_id__deliveries", fields: [deliveryId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  SupplyRequestItem   SupplyRequestItem @relation("delivery_items_supply_request_item_id__supply_request_items", fields: [supplyRequestItemId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  ingredientLots      IngredientLot[]   @relation("ingredient_lots_delivery_item_id__delivery_items")

  @@unique([deliveryId, supplyRequestItemId])
  @@index([deliveryId], map: "idx_delivery_items_delivery")
  @@index([supplyRequestItemId], map: "idx_delivery_items_request_item")
  @@map("delivery_items")
  @@schema("foodprint")
}

/// CHECK constraints are defined in the source SQL and are not represented in Prisma.
model DishIngredientEntry {
  dishId            String          @map("dish_id") @db.Uuid
  ingredientEntryId String          @map("ingredient_entry_id") @db.Uuid
  /// Ingredient quantity for ONE standard serving of this Dish. Total demand = required_quantity times serving count (convert units consistently).
  requiredQuantity  Decimal         @map("required_quantity") @db.Decimal(14, 3)
  unit              String          @db.VarChar(30)
  Dish              Dish            @relation("dish_ingredient_entries_dish_id__dishes", fields: [dishId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  IngredientEntry   IngredientEntry @relation("dish_ingredient_entries_ingredient_entry_id__ingredient_entries", fields: [ingredientEntryId], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@id([dishId, ingredientEntryId])
  @@map("dish_ingredient_entries")
  @@schema("foodprint")
}

/// Fixed main ingredients for one occurrence of a dish. Stock maps through School IngredientEntry.
model MenuDayDishIngredient {
  menuDayId          String      @map("menu_day_id") @db.Uuid
  dishId             String      @map("dish_id") @db.Uuid
  mealType           MealType    @map("meal_type")
  ingredientId       String      @map("ingredient_id") @db.Uuid
  quantityPerPortion Decimal     @map("quantity_per_portion") @db.Decimal(14, 3)
  unit               String      @db.VarChar(30)
  menuDish           MenuDayDish @relation(fields: [menuDayId, dishId, mealType], references: [menuDayId, dishId, mealType], onDelete: Cascade, onUpdate: NoAction, map: "fk_menu_dish_ingredient_menu_dish")
  ingredient         Ingredient  @relation(fields: [ingredientId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "fk_menu_dish_ingredient_ingredient")

  @@id([menuDayId, dishId, mealType, ingredientId])
  @@index([ingredientId], map: "idx_menu_dish_ingredient_ingredient")
  @@map("menu_day_dish_ingredients")
  @@schema("foodprint")
}

/// Shared seasoning standard for ONE serving of the whole meal, never once per dish.
model MenuMealSeasoning {
  menuDayId          String                 @map("menu_day_id") @db.Uuid
  mealType           MealType               @map("meal_type")
  ingredientEntryId  String                 @map("ingredient_entry_id") @db.Uuid
  quantityPerPortion Decimal                @map("quantity_per_portion") @db.Decimal(14, 3)
  unit               String                 @db.VarChar(30)
  menuDay            MenuDay                @relation(fields: [menuDayId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_menu_meal_seasoning_menu_day")
  ingredientEntry    IngredientEntry        @relation(fields: [ingredientEntryId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "fk_menu_meal_seasoning_entry")
  lots               MenuMealSeasoningLot[]

  @@id([menuDayId, mealType, ingredientEntryId])
  @@index([ingredientEntryId], map: "idx_menu_meal_seasoning_entry")
  @@map("menu_meal_seasonings")
  @@schema("foodprint")
}

/// Shared meal reservations; used_at marks consumption when every meal batch is complete.
model MenuMealSeasoningLot {
  id                String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  menuDayId         String            @map("menu_day_id") @db.Uuid
  mealType          MealType          @map("meal_type")
  ingredientEntryId String            @map("ingredient_entry_id") @db.Uuid
  ingredientLotId   String            @map("ingredient_lot_id") @db.Uuid
  plannedPortions   Int               @map("planned_portions") @db.Integer
  quantityUsed      Decimal           @map("quantity_used") @db.Decimal(14, 3)
  unit              String            @db.VarChar(30)
  usedAt            DateTime?         @map("used_at") @db.Timestamptz(6)
  seasoning         MenuMealSeasoning @relation(fields: [menuDayId, mealType, ingredientEntryId], references: [menuDayId, mealType, ingredientEntryId], onDelete: Restrict, onUpdate: NoAction, map: "fk_menu_meal_seasoning_lot_standard")
  ingredientLot     IngredientLot     @relation(fields: [ingredientLotId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "fk_menu_meal_seasoning_lot_lot")

  @@unique([menuDayId, mealType, ingredientEntryId, ingredientLotId], map: "uq_menu_meal_seasoning_lot")
  @@index([ingredientLotId, usedAt], map: "idx_menu_meal_seasoning_lot_reserved")
  @@map("menu_meal_seasoning_lots")
  @@schema("foodprint")
}

model Dish {
  id                    String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schoolId              String                @map("school_id") @db.Uuid
  name                  String                @db.VarChar(255)
  description           String?               @db.Text
  status                EntityStatus          @default(ACTIVE)
  createdAt             DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime              @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  School                School                @relation("dishes_school_id__schools", fields: [schoolId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  menuDayDishes         MenuDayDish[]         @relation("menu_day_dishes_dish_id__dishes")
  dishIngredientEntries DishIngredientEntry[] @relation("dish_ingredient_entries_dish_id__dishes")
  cookingBatches        CookingBatch[]        @relation("cooking_batches_dish_id__dishes")

  @@unique([schoolId, name])
  @@map("dishes")
  @@schema("foodprint")
}

/// Records food or ingredient analysis/test results associated with a FoodSafetyIncident. Does not imply any laboratory integration.
/// CHECK constraints are defined in the source SQL and are not represented in Prisma.
model FoodAnalysisResult {
  id                   String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  incidentId           String              @map("incident_id") @db.Uuid
  ingredientLotId      String?             @map("ingredient_lot_id") @db.Uuid
  retainedFoodSampleId String?             @map("retained_food_sample_id") @db.Uuid
  laboratoryName       String?             @map("laboratory_name") @db.VarChar(255)
  reportNumber         String?             @map("report_number") @db.VarChar(120)
  testType             String?             @map("test_type") @db.VarChar(160)
  sampleDescription    String?             @map("sample_description") @db.Text
  sampledAt            DateTime?           @map("sampled_at") @db.Timestamptz(6)
  testedAt             DateTime?           @map("tested_at") @db.Timestamptz(6)
  resultSummary        String              @map("result_summary") @db.Text
  documentUrl          String?             @map("document_url") @db.Text
  recordedByUserId     String?             @map("recorded_by_user_id") @db.Uuid
  createdAt            DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime            @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  FoodSafetyIncident   FoodSafetyIncident  @relation("food_analysis_results_incident_id__food_safety_incidents", fields: [incidentId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  IngredientLot        IngredientLot?      @relation("food_analysis_results_ingredient_lot_id__ingredient_lots", fields: [ingredientLotId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  RetainedFoodSample   RetainedFoodSample? @relation("food_analysis_results_retained_food_sample_id__retained_food_samples", fields: [retainedFoodSampleId], references: [id], onDelete: Restrict, onUpdate: NoAction)
