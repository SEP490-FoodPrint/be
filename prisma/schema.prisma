/// One row per anchored version of a business record. Exactly one subject link is set,
/// matching entity_type (CHECK in SQL); see specs/unified-blockchain-proofs.
model BlockchainProof {
  id                    String                       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  entityType            BlockchainProofEntityType    @map("entity_type")
  eventType             BlockchainProofEventType     @map("event_type")
  version               Int                          @db.Integer
  previousProofId       String?                      @map("previous_proof_id") @db.Uuid
  registrationRequestId String?                      @map("registration_request_id") @db.Uuid
  deliveryId            String?                      @map("delivery_id") @db.Uuid
  cookingBatchId        String?                      @map("cooking_batch_id") @db.Uuid
  retainedFoodSampleId  String?                      @map("retained_food_sample_id") @db.Uuid
  schoolId              String?                      @map("school_id") @db.Uuid
  subjectDate           DateTime?                    @map("subject_date") @db.Date
  recordId              String                       @map("record_id") @db.VarChar(66)
  dataHash              String                       @map("data_hash") @db.VarChar(66)
  hashAlgorithm         String                       @default("KECCAK-256") @map("hash_algorithm") @db.VarChar(30)
  payloadVersion        Int                          @default(1) @map("payload_version") @db.SmallInt
  snapshot              Json                         @db.JsonB
  changeReason          String?                      @map("change_reason") @db.VarChar(255)
  networkName           String                       @map("network_name") @db.VarChar(80)
  contractAddress       String?                      @map("contract_address") @db.VarChar(100)
  transactionHash       String?                      @map("transaction_hash") @db.VarChar(100)
  blockNumber           BigInt?                      @map("block_number") @db.BigInt
  transactionStatus     BlockchainAnchorStatus       @default(PREPARED) @map("transaction_status")
  attemptCount          Int                          @default(0) @map("attempt_count") @db.Integer
  lastError             String?                      @map("last_error") @db.VarChar(500)
  recordedAt            DateTime?                    @map("recorded_at") @db.Timestamptz(6)
  verificationStatus    BlockchainVerificationStatus @default(NOT_VERIFIED) @map("verification_status")
  verificationResult    String?                      @map("verification_result") @db.VarChar(500)
  verifiedAt            DateTime?                    @map("verified_at") @db.Timestamptz(6)
  createdByUserId       String                       @map("created_by_user_id") @db.Uuid
  createdAt             DateTime                     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime                     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  previousProof         BlockchainProof?             @relation("blockchain_proofs_previous", fields: [previousProofId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  nextProofs            BlockchainProof[]            @relation("blockchain_proofs_previous")
  RegistrationRequest   RegistrationRequest?         @relation("blockchain_proofs_registration_request_id__registration_requests", fields: [registrationRequestId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  Delivery              Delivery?                    @relation("blockchain_proofs_delivery_id__deliveries", fields: [deliveryId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  CookingBatch          CookingBatch?                @relation("blockchain_proofs_cooking_batch_id__cooking_batches", fields: [cookingBatchId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  RetainedFoodSample    RetainedFoodSample?          @relation("blockchain_proofs_retained_food_sample_id__retained_food_samples", fields: [retainedFoodSampleId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  School                School?                      @relation("blockchain_proofs_school_id__schools", fields: [schoolId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  createdByUser         User                         @relation("blockchain_proofs_created_by_user_id__users", fields: [createdByUserId], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@unique([recordId], map: "uq_blockchain_proofs_record_id")
  @@unique([registrationRequestId, version], map: "uq_blockchain_proofs_registration_version")
  @@unique([registrationRequestId], map: "uq_blockchain_proofs_registration_approved", where: raw("(event_type = 'APPROVED'::blockchain_proof_event_type)"))
  @@unique([deliveryId, entityType, version], map: "uq_blockchain_proofs_delivery_version")
  @@unique([cookingBatchId, version], map: "uq_blockchain_proofs_cooking_batch_version")
  @@unique([retainedFoodSampleId, version], map: "uq_blockchain_proofs_sample_version")
  @@unique([retainedFoodSampleId, eventType], map: "uq_blockchain_proofs_sample_event")
  @@unique([schoolId, subjectDate, version], map: "uq_blockchain_proofs_distribution_version")
  @@unique([transactionHash], map: "uq_blockchain_proofs_tx_hash", where: raw("transaction_hash IS NOT NULL"))
  @@index([transactionStatus], map: "idx_blockchain_proofs_status")
  @@map("blockchain_proofs")
  @@schema("foodprint")
}

