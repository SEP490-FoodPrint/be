/// User-level denial extension defined in prisma/migrations/20261029000100_user_permission_denials/migration.sql.
/// Deployment status is tracked in database/SCHEMA_BASELINE.md; Client generation does not apply the patch.
/// A row disables a permission for this user in the recorded organization; deleting it restores role inheritance.
/// Exactly one of schoolId, supplierId, communeFoodSafetyUnitId must be set.
/// The SQL patch enforces this with chk_user_permission_denials_exactly_one_organization; Prisma does not represent CHECK constraints.
/// Services must verify current organization membership and that the permission belongs to the user's role.
/// This model does not implement authorization checks or retain a history of restored permissions.
model UserPermissionDenial {
  id                      String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId                  String                 @map("user_id") @db.Uuid
  permissionId            String                 @map("permission_id") @db.Uuid
  schoolId                String?                @map("school_id") @db.Uuid
  supplierId              String?                @map("supplier_id") @db.Uuid
  communeFoodSafetyUnitId String?                @map("commune_food_safety_unit_id") @db.Uuid
  disabledByUserId        String                 @map("disabled_by_user_id") @db.Uuid
  disabledAt              DateTime               @default(now()) @map("disabled_at") @db.Timestamptz(6)
  user                    User                   @relation("user_permission_denials_user_id__users", fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  permission              Permission             @relation("user_permission_denials_permission_id__permissions", fields: [permissionId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  school                  School?                @relation("user_permission_denials_school_id__schools", fields: [schoolId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  supplier                Supplier?              @relation("user_permission_denials_supplier_id__suppliers", fields: [supplierId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  communeFoodSafetyUnit   CommuneFoodSafetyUnit? @relation("user_permission_denials_commune_food_safety_unit_id__commune_food_safety_units", fields: [communeFoodSafetyUnitId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  disabledByUser          User                   @relation("user_permission_denials_disabled_by_user_id__users", fields: [disabledByUserId], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@unique([userId, permissionId, schoolId], map: "uq_user_permission_denials_school", where: raw("school_id IS NOT NULL"))
  @@unique([userId, permissionId, supplierId], map: "uq_user_permission_denials_supplier", where: raw("supplier_id IS NOT NULL"))
  @@unique([userId, permissionId, communeFoodSafetyUnitId], map: "uq_user_permission_denials_commune_unit", where: raw("commune_food_safety_unit_id IS NOT NULL"))
  @@index([permissionId], map: "idx_user_permission_denials_permission_id")
  @@index([disabledByUserId], map: "idx_user_permission_denials_disabled_by")
  @@map("user_permission_denials")
  @@schema("foodprint")
}

